# Nusxasini oling: .env.example → .env, keyin qiymatlarni yozing.
# .env fayli git'ga KIRMAYDI (.gitignore). Tokenni hech kimga yubormang.

# @BotFather bergan token. Bo'sh bo'lsa sayt ishlaydi, faqat "Kirish" o'chiq bo'ladi.
TELEGRAM_BOT_TOKEN=

# Sayt manzili (botdagi "Saytni ochish" tugmasi faqat https bo'lsa ko'rinadi).
SAYT_URL=http://localhost:5173

# Ma'lumotlar bazasi. Standart: backend/data/algoritmi.db (SQLite).
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:parol@localhost/algoritmi  (asyncpg o'rnatiladi)
# DATABASE_URL=

# Production (HTTPS) uchun:
# COOKIE_SECURE=true
# ISHONCHLI_PROKSI=true
